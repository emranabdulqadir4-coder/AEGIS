# Copy to .env and fill in. .env is git-ignored; never commit it.

# Shared secret every host daemon must present (sent as an Authorization header).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AEGIS_TOKEN=replace-with-a-long-random-secret

# Operator password for the dashboard. REQUIRED when binding to anything other than 127.0.0.1.
# Leave empty for local-only development (the dashboard then shows a "local mode" banner).
AEGIS_DASHBOARD_PASSWORD=

# Optional: fixed key for session cookies so logins survive a server restart.
# If empty, a random key is generated at startup and everyone is signed out on restart.
AEGIS_SESSION_SECRET=

# Set to 1 when the dashboard is served over https (marks the session cookie Secure).
AEGIS_SECURE_COOKIE=0

AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=INFO

# Optional comma-separated browser origins, only if the dashboard is hosted on another origin.
AEGIS_ALLOWED_ORIGINS=

# Daemon side: comma-separated process-name fragments to watch (default: python,node,ollama).
# AEGIS_WATCH=python,node,ollama,java

# Escape hatch: allow a non-local bind without the token/password. Do not use on a shared network.
AEGIS_ALLOW_INSECURE=0
